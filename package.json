{
  "name": "zerodoc",
  "description": "Beautiful documentation site for go-zero microservices framework",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:go-zero-release": "node scripts/sync-go-zero-release.mjs",
    "check:go-zero-drift": "node scripts/check-go-zero-drift.mjs",
    "test": "python3 -m unittest discover -s scripts/tests -p 'test_*.py' && node --test scripts/tests/*.test.mjs",
    "check:docs": "python3 scripts/check_docs.py",
    "check:links": "python3 scripts/check_links.py",
    "validate": "npm run check:docs && npm run check:links"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.7",
    "astro": "^7.1.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.3.1"
  }
}
